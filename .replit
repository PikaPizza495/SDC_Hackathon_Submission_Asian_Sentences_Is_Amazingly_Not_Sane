run = "streamlit run app.py --server.port 8501 --server.address 0.0.0.0"

modules = ["python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[agent]
expertMode = true

[[ports]]
localPort = 8501
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "streamlit run app.py --server.port 8501"]
